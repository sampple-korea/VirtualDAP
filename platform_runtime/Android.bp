package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aidl_interface {
    name: "virtualdap-runtime-aidl",
    srcs: ["aidl/**/*.aidl"],
    local_include_dir: "aidl",
    unstable: true,
    backend: {
        java: { enabled: true },
        cpp: { enabled: false },
        ndk: { enabled: false },
        rust: { enabled: false },
    },
}

cc_library_shared {
    name: "libvirtualdap_runtime",
    srcs: ["jni/BridgeProxy.cpp"],
    shared_libs: ["liblog"],
    cflags: ["-Wall", "-Wextra", "-Werror"],
}

android_app {
    name: "VirtualDapPlatformRuntime",
    manifest: "AndroidManifest.xml",
    srcs: ["java/**/*.kt"],
    static_libs: [
        "virtualdap-runtime-aidl-java",
        "android.system.virtualizationservice_internal-java",
        "libcrosvm_android_display_service-java",
    ],
    libs: [
        "framework-virtualization.impl",
        "framework-annotations-lib",
    ],
    jni_libs: ["libvirtualdap_runtime"],
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    optimize: { enabled: true },
}

prebuilt_etc {
    name: "privapp-permissions-virtualdap-runtime",
    src: "permissions/privapp-permissions-virtualdap-runtime.xml",
    sub_dir: "permissions",
    filename_from_src: true,
}
